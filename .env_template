# Copy this file to .env and fill in the actual values locally.
# Do not commit your real .env file.

# ===== OpenAI / 兼容 API 配置（按需填写）=====
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
api_key=your_api_key_here
base_url=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=your_dashscope_api_key_here
# Token Plan 专属 Key（通常以 sk-sp- 开头），用于实时查询和调用订阅模型。
TOKEN_PLAN_API_KEY=your_token_plan_api_key_here

# ===== Gemini 配置（按需填写）=====
BAIDU_SEARCH_API_KEY=your_baidu_search_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=your_gemini_model_here

# ===== 业务参数（可保留默认值）=====
MODEL_PROFILE=gemini_default
# Optional comma-separated Python modules that register additional LLM providers.
LLM_PROVIDER_MODULES=
DATA_URL=http://49.233.215.205:5000/api/external-query
WEB_SEARCH_URL=https://www.baidu.com/s
