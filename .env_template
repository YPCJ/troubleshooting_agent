# Copy this file to .env and fill in the actual values locally.
# Do not commit your real .env file.

BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
api_key=your_api_key_here
DB_HOST=your_db_host_here
DB_PORT=your_db_port_here
DB_USER=your_db_user_here
DB_PASSWORD=your_db_password_here
DB_NAME=your_db_name_here
SECRET_KEY=your_secret_key_here
FLASK_ENV=your_flask_env_here
FLASK_DEBUG=your_flask_debug_here
WORKDIR=your_workdir_here
BAIDU_SEARCH_API_KEY=your_baidu_search_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=your_gemini_model_here
