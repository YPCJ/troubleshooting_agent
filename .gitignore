.DS_Store

# Python artifacts
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# Environment / secrets
.env
.env.*
!.env.example

# IDE / editor
.idea/
.vscode/
.run/
*.pid

# Frontend build artifacts
frontend/node_modules/

# Runtime / generated outputs
*.out
*.log
*.csv
*.png
/dist/
offline-packages/

# Keep the built frontend trackable, including future image assets.
!/frontend/dist/**

# Local account/session/model state and LangGraph checkpoints must not be published.
/data/auth.sqlite3*
/data/session.sqlite3*
/data/model_profiles.sqlite3*
/data/sbc_langgraph_checkpoints.sqlite3*
/data/troubleshooting.db*
# SQLite transient sidecar files (also for otherwise trackable simulation DBs).
/data/*-wal
/data/*-shm
/data/*-journal

# Generated local analysis reports
# Ignore root-level reports whose filenames include a date/time suffix
/故障初步分析_*_[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]_[0-9][0-9][0-9][0-9][0-9][0-9].md

# Project-generated memory/output artifacts
apps/**/memory/
apps/**/output/
skills/**/output/
skills/figure-plot/assets/
