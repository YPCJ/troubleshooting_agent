# Copy to .env after extraction. Use long unique passwords; do not put real keys in the archive.
AGENT_API_HOST=0.0.0.0
AGENT_API_PORT=8001
AGENT_SERVE_FRONTEND=1
AGENT_APP_MODE=sbc
# Set to 1 only if the trusted intranet model endpoint uses plain HTTP.
ALLOW_INSECURE_LLM_HTTP=1
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SUPER_ADMIN_PASSWORD=
INTRANET_LLM_BASE_URL=
INTRANET_LLM_MODEL=
# Use a nonempty placeholder if the intranet service does not authenticate.
INTRANET_LLM_API_KEY=
